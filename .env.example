# ── Ollama (local, free — used when OPENAI_API_KEY is not set) ──
# Default values work out of the box if Ollama is running locally.
# Pull the model first:  ollama pull qwen3:14b  (~9 GB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b

# ── OpenAI (optional, pay-per-use — takes priority over Ollama) ──
# OPENAI_API_KEY=sk-...
